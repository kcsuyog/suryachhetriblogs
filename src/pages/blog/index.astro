---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { publishedPosts, categories, categorySlug } from '../../lib/posts';
const posts = await publishedPosts();
---
<Layout title="सबै लेखहरू"><section class="wrap archive"><div class="archive-header"><p class="section-kicker">लेखसङ्ग्रह</p><h1>लेख तथा संस्मरण</h1><p>अध्ययन, यात्रा र जीवनका अनुभवसँग सम्बन्धित लेखहरू।</p></div><nav class="category-links archive-tabs" aria-label="लेखका विषय"><a href="/blog/" aria-current="page">सबै लेखहरू</a>{categories.map(category => <a href={`/category/${categorySlug[category]}/`}>{category}</a>)}</nav><div class="post-grid">{posts.map(post => <PostCard post={post} />)}</div></section></Layout>

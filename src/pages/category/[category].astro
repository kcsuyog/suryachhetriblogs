---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { publishedPosts, categories, categorySlug } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await publishedPosts();
  return categories.map(category => ({ params: { category: categorySlug[category] }, props: { category, posts: posts.filter(post => post.data.category === category) } }));
}
const { category, posts } = Astro.props;
const descriptions = { 'सिकाइ': 'जिज्ञासा, किताब र साना अभ्यासबाट सिकेका कुराहरू।', 'यात्रा': 'नयाँ बाटाहरू, भेटिएका मान्छेहरू र फर्केर ल्याएका सम्झनाहरू।', 'अनुभव': 'जीवनका साधारण पलहरूले छोडेका असाधारण अर्थहरू।' };
---
<Layout title={category} description={descriptions[category]}><section class="wrap archive"><div class="archive-header"><p class="section-kicker">लेखसङ्ग्रह</p><h1>{category}</h1><p>{descriptions[category]}</p></div><nav class="category-links archive-tabs" aria-label="लेखका विषय"><a href="/blog/">सबै लेखहरू</a>{categories.map(item => <a href={`/category/${categorySlug[item]}/`} aria-current={category === item ? 'page' : undefined}>{item}</a>)}</nav><div class="post-grid">{posts.map(post => <PostCard post={post} />)}</div></section></Layout>

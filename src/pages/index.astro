---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { publishedPosts, categories, categorySlug, formatDate, readingTime } from '../lib/posts';
const posts = await publishedPosts();
const featured = posts[0];
---
<Layout>
  <section class="hero wrap">
    <div class="hero-copy"><p class="intro-line">सूर्य क्षेत्रीको व्यक्तिगत लेखसङ्ग्रह</p><h1>अध्ययन, यात्रा र<br />जीवनका अनुभूतिहरू</h1><p>ज्ञानको खोजी, यात्राका संस्मरण र जीवनबाट प्राप्त अनुभवहरूलाई नेपाली भाषामा प्रस्तुत गर्ने एक व्यक्तिगत लेखन मञ्च।</p></div>
  </section>
  <nav class="themes-band wrap" aria-label="लेखनका विषय">{categories.map(category => <a href={`/category/${categorySlug[category]}/`}>{category}</a>)}</nav>
  <section class="wrap featured-section"><div class="section-heading"><div><h2>नवीनतम लेख</h2></div><a class="text-link" href="/blog/">सबै लेखहरू</a></div>
    {featured && <article class="featured"><a class="featured-image" href={`/blog/${featured.id}/`} tabindex="-1" aria-hidden="true"><img src={featured.data.cover} alt="" width="1200" height="800" loading="lazy" /></a><div class="featured-copy"><span class="category">{featured.data.category}</span><h3><a href={`/blog/${featured.id}/`}>{featured.data.title}</a></h3><p>{featured.data.description}</p><div class="post-meta"><time datetime={featured.data.date.toISOString()}>{formatDate(featured.data.date)}</time><span>{readingTime(featured)} पढाइ</span></div><a class="text-link" href={`/blog/${featured.id}/`}>पूरा लेख पढ्नुहोस्</a></div></article>}
  </section>
  <section class="wrap latest-section"><div class="section-heading"><div><h2>अन्य लेखहरू</h2></div><div class="category-links" aria-label="विषयहरू">{categories.map(category => <a href={`/category/${categorySlug[category]}/`}>{category}</a>)}</div></div><div class="post-grid">{posts.slice(1, 4).map(post => <PostCard post={post} />)}</div></section>
  <section class="about-strip wrap"><div><p class="section-kicker">लेखकका तर्फबाट</p><h2>अध्ययन र अनुभवको निरन्तर संवाद</h2><p>अध्ययनले हाम्रो दृष्टि फराकिलो बनाउँछ। यात्राले समाज र प्रकृतिसँग परिचय गराउँछ। अनुभवले ती बुझाइहरूलाई जीवनसँग जोड्छ। यही संवादलाई शब्दमा अभिलेख गर्ने प्रयास हो यो लेखसङ्ग्रह।</p></div><a class="text-link" href="/about/">लेखक परिचय</a></section>
</Layout>
